{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "(\\.integration\\.spec\\.ts|\\.e2e-spec\\.ts)$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/helpers/global-setup.ts",
  "globalTeardown": "<rootDir>/helpers/global-teardown.ts",
  "testTimeout": 60000
}